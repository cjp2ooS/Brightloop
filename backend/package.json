    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/pdfkit": "^0.13.9",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.4.1",
