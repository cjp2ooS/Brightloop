PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://brightloop:brightloop_password@localhost:5432/brightloop_db?schema=public
JWT_SECRET=brightloop_jwt_secret_key_super_secure_random_change_in_production
JWT_EXPIRES_IN=1d
